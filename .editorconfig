root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.{json,xml,props,targets,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[**/Persistence/Migrations/*.cs]
# EF Core generates migration metadata/snapshots; sealing these generated types
# is not a domain or runtime design concern and can be overwritten by tooling.
dotnet_diagnostic.CA1852.severity = none
